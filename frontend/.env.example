# ── Frontend Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# Vite exposes variables prefixed with VITE_ to the frontend
# code.  This is how the React app knows where the Go API
# lives.

# Base URL of the Go backend API.
# Defaults to relative '/api' so requests stay same-origin and are proxied
# via Nginx in production or Vite dev server in local development.
VITE_API_BASE_URL=/api

