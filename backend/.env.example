# ── Backend Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# These variables are loaded automatically during local
# development.  In Docker / Kubernetes they will be supplied
# as real environment variables instead.

# PostgreSQL connection string.
# Replace user, password, host, port, and dbname as needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskflow?sslmode=disable

# Port the API server listens on.
PORT=8080

# The origin of the React dev server (for CORS).
FRONTEND_ORIGIN=http://localhost:5173

