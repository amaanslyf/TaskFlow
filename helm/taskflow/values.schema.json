{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskFlow Helm Values Schema",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "secret": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "object",
          "properties": {
            "databaseUrl": { "type": "string" },
            "postgresUser": { "type": "string" },
            "postgresPassword": { "type": "string" },
            "postgresDb": { "type": "string" }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["image", "service"],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "required": ["name", "port"],
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "port": { "type": "integer" }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "required": ["image", "service"],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "required": ["name", "port"],
          "properties": {
            "name": { "type": "string" },
            "type": { "type": "string" },
            "port": { "type": "integer" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["image", "service", "persistence"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          }
        },
        "persistence": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "claimName": { "type": "string" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessMode": { "type": "string" }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayClassName": { "type": "string" },
        "name": { "type": "string" },
        "port": { "type": "integer" },
        "protocol": { "type": "string" }
      }
    }
  }
}
