# ── TaskFlow .gitignore ──────────────────────────────────

# Environment files (contain secrets)
.env
.env.local
.env.*.local

# Go build output
backend/tmp/
*.exe

# Node / Vite
frontend/node_modules/
frontend/dist/

# Python virtual environments & test cache
tests/.venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Playwright artifacts
frontend/playwright-report/
frontend/test-results/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

